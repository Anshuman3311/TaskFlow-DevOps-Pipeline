{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow API - a small task management REST API with JWT auth, built to demonstrate a full CI/CD pipeline (Build, Test, Code Quality, Security, Deploy, Release, Monitoring).",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "build": "npm run lint && echo 'Build complete: dependencies installed and code linted.'",
    "test": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "docker:build": "docker build -t taskflow-api:latest .",
    "docker:run": "docker run -p 3000:3000 taskflow-api:latest"
  },
  "keywords": ["jenkins", "devops", "ci-cd", "express", "api"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  }
}
