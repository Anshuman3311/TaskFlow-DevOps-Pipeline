# Copy this file to .env and adjust values for your environment.
# Nothing here is loaded automatically in Docker Compose - see docker-compose.yml
# for how environment variables are passed to containers instead.

PORT=3000
NODE_ENV=development

# Used to sign JWTs. MUST be changed to a long, random value before any
# production deployment - the app will refuse to start in production with
# the default value below.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=2h

# debug | info | warn | error
LOG_LEVEL=debug
